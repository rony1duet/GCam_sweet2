# Git ignore for GCam_sweet2
# Proprietary GCam prebuilts are fetched locally by tools/fetch_gcam_prebuilt.sh.
# Never commit these generated files.
*.apk
*.so

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts (AOSP out/)
out/
*.ota

# Temp
*.tmp
*.bak
