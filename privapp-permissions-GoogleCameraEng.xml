<?xml version="1.0" encoding="utf-8"?>
<!--
    Privileged app permissions for Google Camera (MGC) 9.6.080
    Device: Redmi Note 12 Pro (sweet2)
    Place at: /product/etc/permissions/privapp-permissions-GoogleCameraEng.xml

    In AOSP build this is handled by Android.bp's prebuilt_etc target.
    For manual install: adb push this file to the above path.
-->
<permissions>
    <privapp-permissions package="com.google.android.GoogleCameraEng">
        <!-- Core camera permissions -->
        <permission name="android.permission.CAMERA" />
        <permission name="android.permission.RECORD_AUDIO" />
        <permission name="android.permission.FLASHLIGHT" />

        <!-- Storage -->
        <permission name="android.permission.READ_EXTERNAL_STORAGE" />
        <permission name="android.permission.WRITE_EXTERNAL_STORAGE" />
        <permission name="android.permission.READ_MEDIA_IMAGES" />
        <permission name="android.permission.READ_MEDIA_VIDEO" />
        <permission name="android.permission.MANAGE_EXTERNAL_STORAGE" />

        <!-- Location (for geotagging) -->
        <permission name="android.permission.ACCESS_FINE_LOCATION" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" />

        <!-- System-level camera control -->
        <permission name="android.permission.SYSTEM_CAMERA" />
        <permission name="android.permission.MANAGE_CAMERA" />

        <!-- Misc -->
        <permission name="android.permission.VIBRATE" />
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED" />
        <permission name="android.permission.FOREGROUND_SERVICE" />
        <permission name="android.permission.FOREGROUND_SERVICE_CAMERA" />
        <permission name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

        <!-- HDR / Codec access -->
        <permission name="android.permission.ACCESS_MEDIA_LOCATION" />
    </privapp-permissions>
</permissions>
