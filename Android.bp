// Soong build integration for PixelOS/AOSP.
// The APK contains its own arm64 native libraries; do not declare them as
// separate cc_prebuilt modules.

android_app_import {
    name: "GoogleCameraEng",
    apk: "system/product/app/GoogleCameraEng/GoogleCameraEng.apk",

    product_specific: true,
    privileged: true,
    presigned: true,
    dex_preopt: {
        enabled: false,
    },

    required: [
        "privapp-permissions-GoogleCameraEng",
        "GCam_Config_sweet2",
    ],
}

prebuilt_etc {
    name: "privapp-permissions-GoogleCameraEng",
    src: "privapp-permissions-GoogleCameraEng.xml",
    sub_dir: "permissions",
    product_specific: true,
}

prebuilt_etc {
    name: "GCam_Config_sweet2",
    src: "common/GCam_Config_sweet2.xml",
    sub_dir: "gcam",
    product_specific: true,
}
