// Android.bp for GCam_sweet2
// Used for Soong build system (Android 10+)
// See Android.mk for make-based builds

android_app_import {
    name: "GoogleCameraEng",
    apk: "system/product/app/GoogleCameraEng/GoogleCameraEng.apk",

    // Install to /product/app/GoogleCameraEng/
    product_specific: true,
    privileged: true,

    // Use platform certificate
    certificate: "platform",

    // Presigned — do not re-sign
    presigned: false,

    // JNI libraries (arm64)
    jni_libs: [
        "libandroidx.graphics.path",
        "libannexbtoavcc",
        "libarcore_sdk_c",
        "libarcore_sdk_jni",
        "libbrotli",
        "libcyclops",
        "libeglimage",
        "libgcastartup",
        "libhotshot_object_detector_jni",
        "libimage",
        "libl2l_video_processor_utils_jni",
        "liblightcycle",
        "libnative",
        "libnative_crash_handler_jni",
        "libnative_utils_android",
        "liboliveoil",
        "libpairipcore",
        "libsaliency_predictor_jni",
        "libsegmentation_predictor_jni",
        "libsmartcapture_native",
        "libspeechenhancer_jni_avenhrealtimenative",
    ],

    // Enforce 64-bit ABI
    arch: {
        arm64: {
            apk: "system/product/app/GoogleCameraEng/GoogleCameraEng.apk",
        },
    },

    // Required permissions — granted at install time
    required: ["privapp-permissions-GoogleCameraEng"],
}

// Prebuilt JNI libs (arm64)
cc_prebuilt_library_shared {
    name: "libgcastartup",
    target: { android_arm64: { srcs: ["system/product/app/GoogleCameraEng/lib/arm64/libgcastartup.so"] } },
    product_specific: true,
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libcyclops",
    target: { android_arm64: { srcs: ["system/product/app/GoogleCameraEng/lib/arm64/libcyclops.so"] } },
    product_specific: true,
    strip: { none: true },
}

cc_prebuilt_library_shared {
    name: "libsmartcapture_native",
    target: { android_arm64: { srcs: ["system/product/app/GoogleCameraEng/lib/arm64/libsmartcapture_native.so"] } },
    product_specific: true,
    strip: { none: true },
}

// Prebuilt privapp permissions XML
prebuilt_etc {
    name: "privapp-permissions-GoogleCameraEng",
    src: "privapp-permissions-GoogleCameraEng.xml",
    sub_dir: "permissions",
    product_specific: true,
}

// Copy GCam sweet2 config
prebuilt_etc {
    name: "GCam_Config_sweet2",
    src: "common/GCam_Config_sweet2.xml",
    sub_dir: "gcam",
    product_specific: true,
}
